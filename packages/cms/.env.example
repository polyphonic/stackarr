# Public read configuration. Set these in the docs deployment and local Studio shell.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only publisher credential. Never prefix this variable with NEXT_PUBLIC.
# Keep it in a local secret store, CI secret, or Hermes profile env file.
STACKARR_SANITY_API_TOKEN=
