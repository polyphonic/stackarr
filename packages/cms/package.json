    "schema:deploy": "sanity schema deploy",
    "studio:deploy": "sanity deploy",
    "taxonomy:seed": "node scripts/seed-taxonomy.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./src/index.ts"
}
