{
  "name": "@stackarr/cms",
  "version": "0.3.0-alpha.13",
  "dependencies": {
    "@sanity/client": "8.14.1",
    "@sanity/icons": "5.2.3",
    "@sanity/vision": "6.22.0",
    "sanity": "6.22.0",
    "server-only": "0.0.1",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./sanity.config.ts",
    "./markdown": "./src/markdown.ts"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "private": true,
  "scripts": {
    "article:cleanup": "node scripts/cleanup-article.mjs",
    "article:prepare": "node scripts/prepare-article.mjs",
