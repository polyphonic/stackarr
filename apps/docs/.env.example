# Public landing-page URL
NEXT_PUBLIC_SITE_URL=https://stackarr.app

# Anonymous telemetry collector (server-only)
STACKARR_TELEMETRY_COLLECTOR_ENABLED=true
STACKARR_TELEMETRY_INGEST_KEY=generate-with-openssl-rand-hex-32

# Upstash Redis REST credentials used for distributed API rate limiting
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Neon pooled runtime connection and direct migration connection
DATABASE_URL=postgresql://user:password@pooled-host/database?sslmode=require
DIRECT_URL=postgresql://user:password@direct-host/database?sslmode=require

# Optional shadow database used only when your Neon setup requires it
SHADOW_DATABASE_URL=
