{
  "name": "@stackarr/docs",
  "version": "0.3.0-alpha.19",
  "dependencies": {
    "@dotenvx/dotenvx": "^2.24.1",
    "@heroui/styles": "^3.2.4",
    "@next/third-parties": "~16.2.9",
    "@portabletext/react": "7.0.1",
    "@stackarr/cms": "workspace:*",
    "@stackarr/db": "workspace:*",
    "@stackarr/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "@vercel/functions": "3.9.7",
    "fumadocs-core": "16.11.4",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.11.4",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "db:migrate:local": "node --env-file=.env ../../packages/db/node_modules/prisma/build/index.js migrate deploy --config ../../packages/db/prisma.config.ts",
    "dev": "bash scripts/dev.sh",
    "generate": "fumadocs-mdx",
    "services:down": "docker compose --project-name stackarr-dev down --remove-orphans",
    "services:up": "docker compose --project-name stackarr-dev up -d --wait",
    "start": "next start",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "build:cloudflare": "vinext build",
    "deploy:cloudflare": "node scripts/cloudflare-deploy.mjs",
    "deploy:cloudflare:preview": "node scripts/cloudflare-deploy.mjs --preview",
    "preview:cloudflare": "wrangler dev",
    "check:cloudflare": "vinext check",
    "env:encrypt": "dotenvx encrypt -fk ../../.env.keys -f src/env/.env.production && dotenvx encrypt -fk ../../.env.keys -f src/env/.env.preview"
  },
  "type": "module"
}
