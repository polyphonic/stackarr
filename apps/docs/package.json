{
  "name": "@stackarr/docs",
  "version": "0.3.0-alpha.25",
  "dependencies": {
    "@heroui/styles": "^3.2.7",
    "@next/third-parties": "~16.4.5",
    "@portabletext/react": "8.0.1",
    "@stackarr/cms": "workspace:*",
    "@stackarr/db": "workspace:*",
    "@stackarr/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.41.0",
    "@vercel/functions": "3.11.0",
    "fumadocs-core": "16.18.0",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-ui": "16.18.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "^6.0.3"
  },
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "db:migrate:local": "node --env-file=.env ../../packages/db/node_modules/prisma/build/index.js migrate deploy --config ../../packages/db/prisma.config.ts",
    "dev": "bash scripts/dev.sh",
    "generate": "fumadocs-mdx",
    "services:down": "docker compose --project-name stackarr-dev down --remove-orphans",
    "services:up": "docker compose --project-name stackarr-dev up -d --wait",
    "start": "next start",
    "typecheck": "pnpm run generate && tsc --noEmit"
  },
  "type": "module"
}
